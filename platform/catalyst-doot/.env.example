WTF_OUTPUT_DIR=../ingestion/outputs/publications
WTF_RAW_DIR=../ingestion/raw
WTF_DASHBOARD_MODE=fixture
WTF_ENABLE_LIVE_SEC=false
WTF_ENABLE_LIVE_ALPACA=false
